public class PdfDocument : Document
{
    public string PdfVersion { get; set; }

    public PdfDocument(string name, string author, string keywords, string subject, string filePath, string pdfVersion)
        : base(name, author, keywords, subject, filePath)
    {
        PdfVersion = pdfVersion;
    }

    // Переопределяем метод и используем base
    public override string GetDocumentInfo()
    {
        // Получаем информацию из базового класса
        string baseInfo = base.GetDocumentInfo();

        // Добавляем информацию о версии PDF
        return $"{baseInfo}\nPDF Version: {PdfVersion}";
    }
}
